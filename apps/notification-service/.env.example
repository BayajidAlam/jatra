# Server Configuration
PORT=3007
NODE_ENV=development

# Database
DATABASE_URL="postgresql://jatra_user:jatra_password@localhost:5432/jatra_db?schema=public"

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_NOTIFICATION_EXCHANGE=notifications
RABBITMQ_NOTIFICATION_QUEUE=notification_queue

# Email Configuration
# EMAIL_PROVIDER: RESEND (recommended), MAILGUN, or MOCK (development/testing)
EMAIL_PROVIDER=MOCK

# Resend Configuration (Recommended - easiest setup):
# 1. Sign up at https://resend.com (Free tier: 3,000 emails/month, no credit card)
# 2. Get API key from: Dashboard > API Keys > Create API Key
# RESEND_API_KEY: Your API key from Resend (starts with re_)
# RESEND_FROM_EMAIL: From email address (use onboarding@resend.dev for testing)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Jatra Railway <onboarding@resend.dev>

# Mailgun SMTP Configuration:
# 1. Sign up at https://mailgun.com (Free tier: 5,000 emails/month for first 3 months, then 100/day)
# 2. Add and verify your sending domain
# 3. Get SMTP credentials from: Sending > Domain Settings > SMTP credentials
# SMTP_USER format: postmaster@your-domain.mailgun.org
# SMTP_PASS: Your SMTP password from Mailgun dashboard
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jatra Railway <noreply@your-domain.mailgun.org>

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

# SMS Provider Configuration
# SMS_PROVIDER: TWILIO (production) or MOCK (development/testing)
SMS_PROVIDER=MOCK

# Twilio SMS Configuration:
# 1. Sign up at https://twilio.com (Trial: $15.50 credit, ~1,900 free SMS)
# 2. Get credentials from: Console > Account Info
# 3. Get phone number from: Phone Numbers > Manage > Active Numbers
# TWILIO_ACCOUNT_SID: Account SID from dashboard
# TWILIO_AUTH_TOKEN: Auth Token from dashboard
# TWILIO_FROM_NUMBER: Your Twilio phone number (format: +1234567890)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
